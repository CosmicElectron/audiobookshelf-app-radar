+/**
+ * Release Radar fork: ONE OkHttp client for the whole app (API calls, the ping
+ * client and ExoPlayer's streaming data source share its connection pool), with
+ * a resolver that tries IPv4 addresses before IPv6. OkHttp 4.9 tries addresses
+ * one after another with a full connect timeout each, so a VPN that hands out
+ * IPv6 which does not actually route made every connection wait for that
+ * timeout before falling back ("takes forever to connect on the VPN").
+ */
+object AbsHttp {
+  val dns = object : Dns {
+    override fun lookup(hostname: String): List<InetAddress> {
+      val all = Dns.SYSTEM.lookup(hostname)
+      return all.filter { it is Inet4Address } + all.filter { it !is Inet4Address }
+    }
+  }
+  val client: OkHttpClient = OkHttpClient.Builder().dns(dns).build()
+}
+
 class ApiHandler(var ctx:Context) {
   val tag = "ApiHandler"
 
