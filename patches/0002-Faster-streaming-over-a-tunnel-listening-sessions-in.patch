diff --git a/pages/media/_id/sessions.vue b/pages/media/_id/sessions.vue
new file mode 100644
index 0000000..6686175
--- /dev/null
+++ b/pages/media/_id/sessions.vue
@@ -0,0 +1,128 @@
+<template>
+  <div class="w-full h-full px-3 py-4 overflow-y-auto relative bg-bg">
+    <p class="mb-1 text-lg font-semibold">Listening sessions</p>
+    <p class="mb-4 text-sm text-fg-muted truncate">{{ title }}</p>
+
+    <div v-if="error" class="text-center py-8">
+      <p class="text-fg">{{ error }}</p>
+    </div>
+    <div v-else-if="!sessions.length && !loading" class="text-center py-8">
+      <p class="text-fg">No sessions on the server for this book</p>
+    </div>
+
+    <p v-if="sessions.length" class="mb-2 text-xs text-fg-muted">{{ total }} session{{ total === 1 ? '' : 's' }} · {{ $elapsedPretty(totalListened, true) }} in the ones shown</p>
+
+    <div v-for="(group, day) in groupedSessions" :key="day" class="py-1">
+      <p class="my-2 text-fg-muted font-semibold">{{ day }}</p>
+      <div v-for="s in group" :key="s.id" class="py-3 flex items-center border-b border-white/5" @click="clickSession(s)">
+        <div class="w-24 flex-shrink-0">
+          <p class="text-sm text-fg">{{ $formatDate(s.startedAt, 'HH:mm') }}<span class="text-fg-muted"> – {{ $formatDate(s.updatedAt, 'HH:mm') }}</span></p>
+          <p class="text-xs text-fg-muted">{{ $elapsedPretty(s.timeListening || 0) }}</p>
+        </div>
+        <div class="flex-grow px-2 min-w-0">
+          <p class="text-sm text-fg truncate">{{ deviceLabel(s) }}</p>
+          <p class="text-xs text-fg-muted">{{ $secondsToTimestampFull(s.startTime || 0) }} → {{ $secondsToTimestampFull(s.currentTime || 0) }}</p>
+        </div>
+        <span class="material-symbols text-2xl text-fg-muted flex-shrink-0 px-1">play_arrow</span>
+      </div>
+    </div>
+
+    <div v-if="page + 1 < numPages" class="py-4 flex justify-center">
+      <ui-btn :loading="loading" @click="loadMore">Load more</ui-btn>
+    </div>
+  </div>
+</template>
+
+<script>
+// Release Radar fork: the server's listening sessions for ONE book, from the
+// player's menu. The same data as the web client's Listening Sessions page
+// (GET /api/me/item/listening-sessions/:libraryItemId), grouped by day; a tap
+// continues playback from where that session ended, whichever device it was on.
+export default {
+  async asyncData({ params, query, app }) {
+    const libraryItemId = query.libraryItemId || params.id
+    const title = query.title || 'Unknown'
+    let sessions = []
+    let total = 0
+    let numPages = 0
+    let error = null
+    const payload = await app.$nativeHttp.get(`/api/me/item/listening-sessions/${libraryItemId}?itemsPerPage=40&page=0`).catch((err) => {
+      console.error('Failed to load listening sessions', err)
+      error = 'Could not load the sessions from the server'
+      return null
+    })
+    if (payload) {
+      sessions = payload.sessions || []
+      total = payload.total || sessions.length
+      numPages = payload.numPages || 1
+    }
+    return { libraryItemId, title, sessions, total, numPages, error }
+  },
+  data() {
+    return {
+      page: 0,
+      loading: false
+    }
+  },
+  computed: {
+    playerIsStartingPlayback() {
+      return this.$store.state.playerIsStartingPlayback
+    },
+    totalListened() {
+      return this.sessions.reduce((sum, s) => sum + (s.timeListening || 0), 0)
+    },
+    groupedSessions() {
+      const today = this.$formatDate(new Date(), 'MMM dd, yyyy')
+      const yesterday = this.$formatDate(Date.now() - 1000 * 60 * 60 * 24, 'MMM dd, yyyy')
+      const groups = {}
+      const sorted = [...this.sessions].sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0))
+      sorted.forEach((s) => {
+        const date = this.$formatDate(s.startedAt || s.updatedAt, 'MMM dd, yyyy')
+        const key = date === today ? 'Today' : date === yesterday ? 'Yesterday' : date
+        if (!groups[key]) groups[key] = []
+        groups[key].push(s)
+      })
+      return groups
+    }
+  },
+  methods: {
+    deviceLabel(s) {
+      const d = s.deviceInfo || {}
+      const client = (d.clientName || '').replace(/^Abs\s*/i, '') || 'Unknown client'
+      const device = d.deviceName || [d.manufacturer, d.model].filter(Boolean).join(' ') || d.osName || ''
+      return device ? `${client} · ${device}` : client
+    },
+    async loadMore() {
+      if (this.loading) return
+      this.loading = true
+      const next = this.page + 1
+      const payload = await this.$nativeHttp.get(`/api/me/item/listening-sessions/${this.libraryItemId}?itemsPerPage=40&page=${next}`).catch((err) => {
+        console.error('Failed to load more listening sessions', err)
+        return null
+      })
+      if (payload) {
+        const seen = new Set(this.sessions.map((s) => s.id))
+        this.sessions = this.sessions.concat((payload.sessions || []).filter((s) => !seen.has(s.id)))
+        this.page = next
+        this.numPages = payload.numPages || this.numPages
+      }
+      this.loading = false
+    },
+    async clickSession(s) {
+      if (this.playerIsStartingPlayback) return
+      await this.$hapticsImpact()
+      this.playAtTime(s.currentTime || 0)
+    },
+    playAtTime(startTime) {
+      // the same hand-off the local history page uses: a local copy wins, else stream
+      this.$store.commit('setPlayerIsStartingPlayback', this.libraryItemId)
+      const localProg = this.$store.getters['globals/getLocalMediaProgressByServerItemId'](this.libraryItemId, null)
+      if (localProg) {
+        this.$eventBus.$emit('play-item', { libraryItemId: localProg.localLibraryItemId, episodeId: localProg.localEpisodeId, serverLibraryItemId: this.libraryItemId, serverEpisodeId: null, startTime })
+      } else {
+        this.$eventBus.$emit('play-item', { libraryItemId: this.libraryItemId, episodeId: null, startTime })
+      }
+    }
+  }
+}
+</script>
