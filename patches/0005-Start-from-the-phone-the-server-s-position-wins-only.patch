+  @JsonIgnore
+  fun fileUri(audioTrack: AudioTrack): Uri? {
+    val base = serverAddress?.trimEnd('/') ?: return null
+    val itemId = libraryItemId ?: return null
+    val rel = audioTrack.metadata?.relPath ?: return null
+    val ino = when (val media = libraryItem?.media) {
+      is Book -> media.audioFiles?.firstOrNull { it.metadata.relPath == rel }?.ino
