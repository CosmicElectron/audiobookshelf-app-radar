@@ -33,6 +33,20 @@ object DeviceManager {
   var serverConnectionConfig: ServerConnectionConfig? = null
 
   val serverConnectionConfigId get() = serverConnectionConfig?.id ?: ""
+
+  // Release Radar fork: before the server has answered (cold start, Android Auto, offline) adopt the saved
+  // config the last session was made with, so its address, token and version are known. Never after a
+  // logout: that clears lastServerConnectionConfigId. Returns true when the current config has [configId].
+  fun adoptSavedConfig(configId: String?): Boolean {
+    if (configId.isNullOrEmpty()) return false
+    if (serverConnectionConfig == null && configId == deviceData.lastServerConnectionConfigId) {
+      getServerConnectionConfig(configId)?.let {
+        serverConnectionConfig = it
+        com.audiobookshelf.app.server.ServerRoute.probe("config restored", force = true)
+      }
+    }
+    return serverConnectionConfigId == configId
+  }
   val serverConnectionConfigName get() = serverConnectionConfig?.name ?: ""
   val serverConnectionConfigString get() = serverConnectionConfig?.name ?: "No server connection"
   val serverAddress
