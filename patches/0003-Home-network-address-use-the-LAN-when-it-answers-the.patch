diff --git a/android/app/src/main/java/com/audiobookshelf/app/server/ServerRoute.kt b/android/app/src/main/java/com/audiobookshelf/app/server/ServerRoute.kt
new file mode 100644
index 0000000..2d8fbe6
--- /dev/null
+++ b/android/app/src/main/java/com/audiobookshelf/app/server/ServerRoute.kt
@@ -0,0 +1,219 @@
+package com.audiobookshelf.app.server
+
+import android.content.Context
+import android.net.ConnectivityManager
+import android.net.Network
+import android.net.NetworkCapabilities
+import android.util.Log
+import com.audiobookshelf.app.device.DeviceManager
+import com.getcapacitor.JSObject
+import okhttp3.Interceptor
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.Response
+import org.json.JSONObject
+import java.io.IOException
+import java.util.concurrent.Executors
+import java.util.concurrent.ScheduledFuture
+import java.util.concurrent.TimeUnit
+
+/**
+ * Release Radar fork: one server, two addresses.
+ *
+ * The server connection config keeps its canonical address (the public
+ * tunnel) as the server's identity everywhere: config id, tokens, downloads,
+ * progress records. An optional home-network address is only a transport:
+ * while it answers, every HTTP request the app makes (API calls, progress
+ * sync, the audio stream, downloads) is rewritten to it by [interceptor]; the
+ * moment it stops answering the next request goes back to the canonical
+ * address on its own. The live socket stays on the canonical address.
+ *
+ * The home address is trusted only after it has proved to be the same server:
+ * /healthcheck answers, /status is Audiobookshelf, and /api/me with our token
+ * returns our own user id (a different server cannot validate our token).
+ */
+object ServerRoute {
+  private const val tag = "ServerRoute"
+  private const val CONNECT_MS = 1500L
+  private const val DOWN_HOLD_MS = 30_000L
+  private const val PROBE_MIN_GAP_MS = 10_000L
+
+  @Volatile var lanOk = false
+    private set
+  @Volatile private var verifiedLocal: String? = null
+  @Volatile private var downUntil = 0L
+  @Volatile private var lastProbeAt = 0L
+  @Volatile private var started = false
+  private val executor = Executors.newSingleThreadScheduledExecutor { r -> Thread(r, "server-route").apply { isDaemon = true } }
+  @Volatile private var pending: ScheduledFuture<*>? = null
+
+  private val probeClient: OkHttpClient by lazy {
+    OkHttpClient.Builder()
+      .dns(AbsHttp.dns)
+      .connectTimeout(CONNECT_MS, TimeUnit.MILLISECONDS)
+      .readTimeout(2500, TimeUnit.MILLISECONDS)
+      .callTimeout(5000, TimeUnit.MILLISECONDS)
+      .retryOnConnectionFailure(false)
+      .build()
+  }
+
+  val canonical: String? get() = DeviceManager.serverConnectionConfig?.address?.trimEnd('/')?.takeIf { it.isNotEmpty() }
+  val local: String? get() {
+    val l = DeviceManager.serverConnectionConfig?.localAddress?.trim()?.trimEnd('/') ?: return null
+    return if (l.isEmpty() || l == canonical) null else l
+  }
+
+  fun isLocal(): Boolean = lanOk && local != null
+  fun active(): String? = if (isLocal()) local else canonical
+
+  fun state(): JSObject {
+    val o = JSObject()
+    o.put("isLocal", isLocal())
+    o.put("active", active() ?: "")
+    o.put("canonical", canonical ?: "")
+    o.put("localAddress", local ?: "")
+    return o
+  }
+
+  /** Canonical <-> home prefix swap for one URL, according to the current state. */
+  fun rewrite(url: String): String {
+    val c = canonical ?: return url
+    val l = local ?: return url
+    return if (lanOk) {
+      if (url.startsWith("$c/") || url == c) l + url.substring(c.length) else url
+    } else {
+      if (url.startsWith("$l/") || url == l) c + url.substring(l.length) else url
+    }
+  }
+
+  private fun toCanonical(url: String): String {
+    val c = canonical ?: return url
+    val l = local ?: return url
+    return if (url.startsWith("$l/") || url == l) c + url.substring(l.length) else url
+  }
+
+  fun markDown(why: String) {
+    val was = lanOk
+    lanOk = false
+    downUntil = System.currentTimeMillis() + DOWN_HOLD_MS
+    if (was) {
+      Log.i(tag, "home address off: $why")
+      notifyJs()
+    }
+  }
+
+  private fun markUp() {
+    if (!lanOk) {
+      lanOk = true
+      Log.i(tag, "home address on: ${local}")
+      notifyJs()
+    }
+  }
+
+  private fun notifyJs() {
+    try {
+      ApiHandler.notifyJs("onServerRouteChanged", state())
+    } catch (e: Exception) {
+      Log.w(tag, "notify failed: ${e.message}")
+    }
+  }
+
+  /** Probe soon, coalescing bursts of network events. */
+  fun probeSoon(reason: String, delayMs: Long = 1500) {
+    pending?.cancel(false)
+    pending = executor.schedule({ probe(reason, force = false) }, delayMs, TimeUnit.MILLISECONDS)
+  }
+
+  /** Probe now on the route thread (never on the caller's thread). */
+  fun probe(reason: String, force: Boolean) {
+    executor.execute {
+      try {
+        val now = System.currentTimeMillis()
+        if (local == null) { if (lanOk) markDown("no home address"); return@execute }
+        if (!force && now < downUntil) return@execute
+        if (!force && now - lastProbeAt < PROBE_MIN_GAP_MS && lanOk) return@execute
+        lastProbeAt = now
+        val ok = try { sameServerReachable() } catch (e: Exception) { Log.d(tag, "probe ($reason): ${e.javaClass.simpleName} ${e.message}"); false }
+        if (ok) markUp() else markDown("probe ($reason) failed")
+      } catch (e: Exception) {
+        Log.w(tag, "probe error: ${e.message}")
+      }
+    }
+  }
+
+  private fun get(url: String, token: String? = null): Response {
+    val b = Request.Builder().url(url)
+    if (token != null) b.addHeader("Authorization", "Bearer $token")
+    return probeClient.newCall(b.build()).execute()
+  }
+
+  private fun sameServerReachable(): Boolean {
+    val l = local ?: return false
+    val cfg = DeviceManager.serverConnectionConfig ?: return false
+    get("$l/healthcheck").use { if (!it.isSuccessful) return false }
+    if (verifiedLocal == l) return true
+    // the same server, proven before the token is ever sent there
+    get("$l/status").use { r ->
+      if (!r.isSuccessful) return false
+      val j = JSONObject(r.body?.string() ?: return false)
+      if (j.optString("app") != "audiobookshelf") return false
+      val ver = j.optString("serverVersion")
+      val want = cfg.version
+      if (!want.isNullOrEmpty() && ver.isNotEmpty() && ver != want) {
+        Log.i(tag, "home address runs $ver, our server is $want: not the same server")
+        return false
+      }
+    }
+    get("$l/api/me", cfg.token).use { r ->
+      if (r.code != 200) return false
+      val j = JSONObject(r.body?.string() ?: return false)
+      if (j.optString("id") != cfg.userId) return false
+    }
+    verifiedLocal = l
+    return true
+  }
+
+  /** Register the default-network callback once per process. */
+  @Synchronized
+  fun start(ctx: Context) {
+    if (started) return
+    started = true
+    try {
+      val cm = ctx.applicationContext.getSystemService(Context.CONNECTIVITY_SERVICE) as ConnectivityManager
+      cm.registerDefaultNetworkCallback(object : ConnectivityManager.NetworkCallback() {
+        override fun onAvailable(network: Network) { probeSoon("network available") }
+        override fun onLost(network: Network) { markDown("network lost"); probeSoon("network lost", 3000) }
+        override fun onCapabilitiesChanged(network: Network, caps: NetworkCapabilities) {
+          // Wi-Fi <-> cellular hand-over: re-check straight away
+          probeSoon("network changed")
+        }
+      })
+    } catch (e: Exception) {
+      Log.w(tag, "could not register network callback: ${e.message}")
+    }
+    probeSoon("start", 500)
+  }
+
+  /**
+   * Installed on the shared OkHttp client (API, player, downloads). A request
+   * for the canonical address goes to the home address while that is up;
+   * if the home address fails to connect, the request is retried once on the
+   * canonical address and the home address is held off for a while.
+   */
+  val interceptor = Interceptor { chain ->
+    val original = chain.request()
+    val url = original.url.toString()
+    val routed = rewrite(url)
+    val viaLocal = routed != url && lanOk && local != null && routed.startsWith(local!!)
+    val request = if (routed == url) original else original.newBuilder().url(routed).build()
+    if (!viaLocal) return@Interceptor chain.proceed(request)
+    try {
+      chain.withConnectTimeout(CONNECT_MS.toInt(), TimeUnit.MILLISECONDS).proceed(request)
+    } catch (e: IOException) {
+      markDown("request failed: ${e.javaClass.simpleName}")
+      val idempotent = original.method == "GET" || original.method == "HEAD"
+      if (!idempotent) throw e
+      chain.proceed(original.newBuilder().url(toCanonical(url)).build())
+    }
+  }
+}
