+package com.audiobookshelf.app.player
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.net.ConnectivityManager
+import android.util.Log
+import com.audiobookshelf.app.data.AudioTrack
+import com.audiobookshelf.app.data.PlaybackSession
+import com.audiobookshelf.app.device.DeviceManager
+import com.audiobookshelf.app.plugins.AbsLogger
+import com.audiobookshelf.app.server.AbsHttp
+import com.google.android.exoplayer2.C
+import com.google.android.exoplayer2.database.StandaloneDatabaseProvider
+import com.google.android.exoplayer2.ext.okhttp.OkHttpDataSource
+import com.google.android.exoplayer2.upstream.DataSource
+import com.google.android.exoplayer2.upstream.DataSpec
+import com.google.android.exoplayer2.upstream.HttpDataSource
+import com.google.android.exoplayer2.upstream.cache.CacheDataSource
+import com.google.android.exoplayer2.upstream.cache.CacheKeyFactory
+import com.google.android.exoplayer2.upstream.cache.CacheWriter
+import com.google.android.exoplayer2.upstream.cache.LeastRecentlyUsedCacheEvictor
+import com.google.android.exoplayer2.upstream.cache.SimpleCache
+import org.json.JSONObject
+import java.io.File
+import java.io.InterruptedIOException
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.Executors
+import java.util.concurrent.Future
+import java.util.concurrent.TimeUnit
+import kotlin.math.abs
+
+/**
+ * Release Radar fork: an on-disk cache for streamed (direct play) audio, so the
+ * last played book starts from the phone instead of from the server.
+ *
+ * Everything ExoPlayer reads for a streamed book passes through this cache: the
+ * index at the head of the file (up to tens of MB, read on every open) and the
+ * audio it buffers around the playhead, which the load control keeps ten
+ * minutes ahead while paused. On top of that, [prebuffer] writes windows of
+ * [BEHIND_S] before and [AHEAD_S] after positions the player is NOT sitting at:
+ * where this phone left the book (recorded here, every 15 s while playing and
+ * on pause) and where the server says it is (the synced position another
+ * device may have moved). Both windows are kept, so starting at either is
+ * instant, and the player offers the way back.
+ *
+ * Stream URLs are per server session, so entries are keyed by the file they
+ * point at (item, track, size, duration, path) rather than by URL: the cache
+ * survives new sessions, token refreshes and the home-network/tunnel switch.
+ */
+object StreamCache {
+  private const val tag = "StreamCache"
+  private const val MAX_BYTES = 768L * 1024 * 1024
+  private const val BEHIND_S = 60.0
+  private const val AHEAD_S = 600.0
+  private const val STARTUP_MAX_AGE_MS = 24L * 3600 * 1000
+  private const val SAME_WINDOW_MS = 90_000L
+  private const val POSITIONS_KEPT = 12
+  private const val NO_PROGRESS_MS = 20_000L
+
+  @Volatile private var cache: SimpleCache? = null
+  private var prefs: SharedPreferences? = null
+  private var appContext: Context? = null
+  private val keys = ConcurrentHashMap<String, String>()
+  private val audioStarts = ConcurrentHashMap<String, Long>()
+  private val executor = Executors.newSingleThreadScheduledExecutor { r ->
+    Thread(r, "stream-prebuffer").apply { isDaemon = true; priority = Thread.MIN_PRIORITY }
+  }
+  private val watchdog = Executors.newSingleThreadScheduledExecutor { r -> Thread(r, "stream-prebuffer-watchdog").apply { isDaemon = true } }
+  @Volatile private var task: Future<*>? = null
+  @Volatile private var writer: CacheWriter? = null
+  @Volatile private var generation = 0
+  @Volatile private var upstream: DataSource.Factory? = null
+
+  /** Per session: the synced position it started at and where this phone was before. */
+  @Volatile private var candidateSessionId: String? = null
+  @Volatile private var syncedStartMs: Long? = null
+  @Volatile private var localStartMs: Long? = null
+
+  private val keyFactory = CacheKeyFactory { spec ->
+    keys[stripToken(spec.uri.toString())] ?: CacheKeyFactory.DEFAULT.buildCacheKey(spec)
+  }
+
+  @Synchronized
+  fun init(ctx: Context) {
+    if (cache != null) return
+    try {
+      appContext = ctx.applicationContext
+      val dir = File(ctx.filesDir, "stream-cache")
+      cache = SimpleCache(dir, LeastRecentlyUsedCacheEvictor(MAX_BYTES), StandaloneDatabaseProvider(ctx))
+      prefs = ctx.getSharedPreferences("stream-cache", Context.MODE_PRIVATE)
+      AbsLogger.info(tag, "init: ${(cache?.cacheSpace ?: 0) / 1048576} MB cached, limit ${MAX_BYTES / 1048576} MB")
+    } catch (e: Exception) {
+      AbsLogger.error(tag, "init failed, streaming without a cache: ${e.javaClass.simpleName} ${e.message}")
+    }
+  }
+
+  private fun stripToken(uri: String): String {
+    val q = uri.indexOf("?token=")
+    return if (q >= 0) uri.substring(0, q) else uri
+  }
+
+  private fun key(session: PlaybackSession, track: AudioTrack): String =
+    "${session.libraryItemId}|${track.index}|${track.metadata?.size ?: 0}|${track.durationMs}|${track.metadata?.relPath ?: ""}"
+
+  /** Map this session's stream URLs to file-based cache keys. */
+  fun register(session: PlaybackSession) {
+    if (session.isLocal || !session.isDirectPlay) return
+    session.audioTracks.forEach { t ->
+      keys[stripToken(session.getContentUri(t).toString())] = key(session, t)
+    }
+  }
+
+  /** The player's data source: cache in front of the network. */
+  fun wrap(factory: DataSource.Factory): DataSource.Factory {
+    val c = cache ?: return factory
+    upstream = factory
+    return CacheDataSource.Factory()
+      .setCache(c)
+      .setUpstreamDataSourceFactory(factory)
+      .setCacheKeyFactory(keyFactory)
+      .setFlags(CacheDataSource.FLAG_IGNORE_CACHE_ON_ERROR)
+  }
+
+  private fun metered(): Boolean = try {
+    val cm = appContext?.getSystemService(Context.CONNECTIVITY_SERVICE) as? ConnectivityManager
+    cm?.isActiveNetworkMetered ?: false
+  } catch (_: Exception) { false }
+
+  // ---- the positions of this phone, per library item ----
+
+  @Synchronized
+  fun recordPosition(itemId: String?, positionMs: Long) {
+    val p = prefs ?: return
+    if (itemId.isNullOrEmpty() || positionMs < 0) return
+    try {
+      val all = JSONObject(p.getString("positions", "{}") ?: "{}")
+      all.put(itemId, JSONObject().put("ms", positionMs).put("at", System.currentTimeMillis()))
+      if (all.length() > POSITIONS_KEPT) {
+        val oldest = all.keys().asSequence().minByOrNull { all.getJSONObject(it).optLong("at") }
+        if (oldest != null) all.remove(oldest)
+      }
+      p.edit().putString("positions", all.toString()).apply()
+    } catch (e: Exception) {
+      Log.w(tag, "recordPosition: ${e.message}")
+    }
+  }
+
+  @Synchronized
+  fun localPosition(itemId: String?): Long? {
+    val p = prefs ?: return null
+    if (itemId.isNullOrEmpty()) return null
+    return try {
+      JSONObject(p.getString("positions", "{}") ?: "{}").optJSONObject(itemId)?.optLong("ms")
+    } catch (e: Exception) { null }
+  }
+
+  /** Remember the two positions that matter for this session. */
+  fun setCandidates(session: PlaybackSession, syncedMs: Long, localMs: Long?) {
+    candidateSessionId = session.id
+    syncedStartMs = syncedMs
+    localStartMs = localMs
+  }
+
+  fun syncedStart(session: PlaybackSession): Long? = if (candidateSessionId == session.id) syncedStartMs else null
+  fun localStart(session: PlaybackSession): Long? = if (candidateSessionId == session.id) localStartMs else null
+
+  /** The positions to keep cached for this session, besides the one the player sits at. */
+  fun candidates(session: PlaybackSession): List<Long> =
+    if (candidateSessionId == session.id) listOfNotNull(syncedStartMs, localStartMs) else emptyList()
+
+  // ---- where the audio starts in the file ----
+
+  private fun readAt(ds: DataSource, session: PlaybackSession, track: AudioTrack, position: Long, length: Int): ByteArray? {
+    val spec = DataSpec.Builder().setUri(session.getContentUri(track)).setPosition(position).setLength(length.toLong())
+      .setKey(key(session, track)).build()
+    return try {
+      ds.open(spec)
+      val buf = ByteArray(length)
+      var off = 0
+      while (off < length) {
+        val n = ds.read(buf, off, length - off)
+        if (n == C.RESULT_END_OF_INPUT) break
+        off += n
+      }
+      buf.copyOf(off)
+    } catch (e: Exception) {
+      null
+    } finally {
+      try { ds.close() } catch (_: Exception) {}
+    }
+  }
+
+  private fun u32(b: ByteArray, o: Int): Long =
+    ((b[o].toLong() and 0xff) shl 24) or ((b[o + 1].toLong() and 0xff) shl 16) or ((b[o + 2].toLong() and 0xff) shl 8) or (b[o + 3].toLong() and 0xff)
+
+  /**
+   * For MP4-family files the audio bytes start at the mdat box, after an index
+   * that can be tens of MB; the byte estimate for a time must skip it. Walks
+   * the top-level boxes (a few 16-byte reads, served from the cache once the
+   * player has opened the file). Other formats start at 0.
+   */
+  private fun audioStart(session: PlaybackSession, track: AudioTrack, c: SimpleCache): Long {
+    val ext = (track.metadata?.ext ?: "").lowercase().trimStart('.')
+    if (ext !in setOf("m4b", "m4a", "mp4", "aac") && !(track.mimeType ?: "").contains("mp4")) return 0L
+    val k = key(session, track)
+    audioStarts[k]?.let { return it }
+    val size = track.metadata?.size ?: return 0L
+    val ds = CacheDataSource.Factory().setCache(c).setUpstreamDataSourceFactory(upstream ?: OkHttpDataSource.Factory(AbsHttp.client))
+      .setCacheKeyFactory(keyFactory).setFlags(CacheDataSource.FLAG_IGNORE_CACHE_ON_ERROR).createDataSource()
+    var off = 0L
+    var found = 0L
+    for (i in 0 until 12) {
+      val hdr = readAt(ds, session, track, off, 16) ?: break
+      if (hdr.size < 8) break
+      var boxSize = u32(hdr, 0)
+      val type = String(hdr, 4, 4, Charsets.ISO_8859_1)
+      if (boxSize == 1L && hdr.size >= 16) boxSize = (u32(hdr, 8) shl 32) or u32(hdr, 12)
+      if (boxSize == 0L) boxSize = size - off
+      if (type == "mdat") { found = off; break }
+      if (boxSize < 8 || off + boxSize >= size) break
+      off += boxSize
+    }
+    audioStarts[k] = found
+    return found
+  }
+
+  // ---- the pre-buffer ----
+
+  private data class Window(val track: AudioTrack, val from: Long, val to: Long, val aroundMs: Long)
+
+  private fun window(session: PlaybackSession, positionMs: Long, c: SimpleCache): Window? {
+    val track = session.audioTracks.firstOrNull { positionMs >= it.startOffsetMs && positionMs < it.endOffsetMs }
+      ?: session.audioTracks.lastOrNull() ?: return null
+    val size = track.metadata?.size ?: return null
+    if (size <= 0 || track.duration <= 0) return null
+    val header = audioStart(session, track, c).coerceIn(0L, size)
+    val bytesPerSecond = (size - header) / track.duration
+    val trackPosS = (positionMs - track.startOffsetMs) / 1000.0
+    val from = header + ((trackPosS - BEHIND_S).coerceAtLeast(0.0) * bytesPerSecond).toLong()
+    val to = (header + ((trackPosS + AHEAD_S) * bytesPerSecond).toLong()).coerceAtMost(size)
+    return if (to > from) Window(track, from, to, positionMs) else null
+  }
+
+  /**
+   * Keep the audio around each of [positionsMs] (session time) on disk. Runs on
+   * its own thread; cancelled by the next call, by [cancel], or by the watchdog
+   * when a window makes no progress for [NO_PROGRESS_MS] (the player holding
+   * the same range open, or a dead server session). Skipped on metered networks.
+   */
+  fun prebuffer(session: PlaybackSession, positionsMs: List<Long>, reason: String, delayMs: Long = 0) {
+    val c = cache ?: return
+    if (session.isLocal || !session.isDirectPlay) return
+    if (positionsMs.isEmpty()) return
+    register(session)
+    try {
+      prefs?.edit()?.putString("sessionId", session.id)?.putLong("positionMs", positionsMs.first())
+        ?.putLong("at", System.currentTimeMillis())?.apply()
+    } catch (_: Exception) {}
+    val gen = ++generation
+    cancelRunning()
+    task = executor.schedule({
+      if (metered()) { Log.d(tag, "prebuffer ($reason): metered network, skipped"); return@schedule }
+      val distinct = mutableListOf<Long>()
+      positionsMs.forEach { p -> if (distinct.none { abs(it - p) < SAME_WINDOW_MS }) distinct.add(p) }
+      val windows = distinct.mapNotNull { window(session, it, c) }
+      for (w in windows) {
+        if (gen != generation || Thread.currentThread().isInterrupted) return@schedule
+        val key = key(session, w.track)
+        val wanted = w.to - w.from
+        val have = c.getCachedBytes(key, w.from, wanted)
+        if (have >= wanted) {
+          Log.d(tag, "prebuffer ($reason): window at ${w.aroundMs / 1000} s already cached")
+          continue
+        }
+        val ds = CacheDataSource.Factory()
+          .setCache(c)
+          .setUpstreamDataSourceFactory(upstream ?: OkHttpDataSource.Factory(AbsHttp.client))
+          .setCacheKeyFactory(keyFactory)
+          .createDataSourceForDownloading()
+        val spec = DataSpec.Builder().setUri(session.getContentUri(w.track)).setPosition(w.from).setLength(wanted).setKey(key).build()
+        var progressAt = System.currentTimeMillis()
+        val cw = CacheWriter(ds, spec, null) { _, _, _ -> progressAt = System.currentTimeMillis() }
+        writer = cw
+        val me = task
+        val guard = watchdog.scheduleWithFixedDelay({
+          if (System.currentTimeMillis() - progressAt > NO_PROGRESS_MS) {
+            Log.d(tag, "prebuffer ($reason): no progress for ${NO_PROGRESS_MS / 1000} s, giving up on this window")
+            cw.cancel()
+            me?.cancel(true)
+          }
+        }, NO_PROGRESS_MS, 5000, TimeUnit.MILLISECONDS)
+        val t0 = System.currentTimeMillis()
+        try {
+          cw.cache()
+          AbsLogger.info(tag, "prebuffer ($reason): ${(wanted - have) / 1024} KB around ${w.aroundMs / 1000} s of " +
+            "${session.displayTitle} in ${System.currentTimeMillis() - t0} ms")
+        } catch (e: InterruptedIOException) {
+          Log.d(tag, "prebuffer ($reason) cancelled")
+          return@schedule
+        } catch (e: HttpDataSource.InvalidResponseCodeException) {
+          Log.d(tag, "prebuffer ($reason): server answered ${e.responseCode} (session gone?)")
+          return@schedule
+        } catch (e: Exception) {
+          if (Thread.currentThread().isInterrupted) return@schedule
+          AbsLogger.error(tag, "prebuffer ($reason) failed: ${e.javaClass.simpleName} ${e.message?.take(160)}")
+          return@schedule
+        } finally {
+          guard.cancel(false)
+          if (writer === cw) writer = null
+        }
+      }
+    }, delayMs, TimeUnit.MILLISECONDS)
+  }
+
+  fun prebuffer(session: PlaybackSession, positionMs: Long, reason: String, delayMs: Long = 0) =
+    prebuffer(session, listOf(positionMs), reason, delayMs)
+
+  /**
+   * At service start and when the server config is set: warm the windows of
+   * the last streamed book before anyone presses play (only if this phone
+   * touched it within a day, so its server session is likely still open).
+   */
+  fun prebufferLastSession(reason: String) {
+    val s = DeviceManager.deviceData.lastPlaybackSession ?: return
+    if (s.isLocal || !s.isDirectPlay) return
+    if (s.serverConnectionConfigId != DeviceManager.serverConnectionConfigId) return
+    val p = prefs
+    val at = try { p?.getLong("at", 0L) ?: 0L } catch (_: Exception) { 0L }
+    if (System.currentTimeMillis() - at > STARTUP_MAX_AGE_MS) return
+    val positions = mutableListOf<Long>()
+    try { if (p?.getString("sessionId", null) == s.id) positions.add(p.getLong("positionMs", s.currentTimeMs)) } catch (_: Exception) {}
+    localPosition(s.libraryItemId)?.let { positions.add(it) }
+    positions.add(s.currentTimeMs)
+    prebuffer(s, positions, reason)
+  }
+
+  private fun cancelRunning() {
+    writer?.cancel()
+    task?.cancel(true)
+  }
+
+  fun cancel() {
+    generation++
+    cancelRunning()
+  }
+}
