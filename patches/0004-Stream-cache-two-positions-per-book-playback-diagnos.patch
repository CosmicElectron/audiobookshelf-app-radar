diff --git a/android/app/src/main/java/com/audiobookshelf/app/player/PlaybackDiagnostics.kt b/android/app/src/main/java/com/audiobookshelf/app/player/PlaybackDiagnostics.kt
new file mode 100644
index 0000000..9ae04a8
--- /dev/null
+++ b/android/app/src/main/java/com/audiobookshelf/app/player/PlaybackDiagnostics.kt
@@ -0,0 +1,233 @@
+package com.audiobookshelf.app.player
+
+import android.content.Context
+import android.media.AudioDeviceCallback
+import android.media.AudioDeviceInfo
+import android.media.AudioManager
+import android.os.Handler
+import android.os.Looper
+import com.audiobookshelf.app.plugins.AbsLogger
+import com.google.android.exoplayer2.ExoPlayer
+import com.google.android.exoplayer2.Format
+import com.google.android.exoplayer2.PlaybackException
+import com.google.android.exoplayer2.Player
+import com.google.android.exoplayer2.analytics.AnalyticsListener
+import com.google.android.exoplayer2.analytics.AnalyticsListener.EventTime
+import com.google.android.exoplayer2.audio.AudioAttributes
+import com.google.android.exoplayer2.decoder.DecoderReuseEvaluation
+import com.google.android.exoplayer2.source.LoadEventInfo
+import com.google.android.exoplayer2.source.MediaLoadData
+import java.io.IOException
+import java.util.Locale
+import java.util.concurrent.Executors
+
+/**
+ * Release Radar fork: what the player is doing, written to the log page
+ * (Settings > Logs), so that a "kept playing but no sound" moment leaves a
+ * trace: audio focus, playback suppression, player and device volume, the
+ * audio output devices coming and going, sink/decoder errors, underruns, and
+ * a heartbeat every few minutes while playing.
+ */
+class PlaybackDiagnostics(ctx: Context, private val player: ExoPlayer) : AnalyticsListener {
+  companion object {
+    private const val tag = "Playback"
+    private const val HEARTBEAT_MS = 5 * 60 * 1000L
+  }
+
+  private val audioManager = ctx.getSystemService(Context.AUDIO_SERVICE) as AudioManager
+  private val handler = Handler(Looper.getMainLooper())
+  private val io = Executors.newSingleThreadExecutor { r -> Thread(r, "playback-diagnostics").apply { isDaemon = true } }
+  private var lastState = -1
+  private var volumeFull = true
+  private var volumeLoggedAt = 0L
+
+  private val deviceCallback = object : AudioDeviceCallback() {
+    override fun onAudioDevicesAdded(added: Array<out AudioDeviceInfo>) {
+      val sinks = added.filter { it.isSink && interesting(it) }
+      if (sinks.isNotEmpty()) log("audio output added: ${sinks.joinToString { describe(it) }}; ${snapshot()}")
+    }
+    override fun onAudioDevicesRemoved(removed: Array<out AudioDeviceInfo>) {
+      val sinks = removed.filter { it.isSink && interesting(it) }
+      if (sinks.isNotEmpty()) log("audio output removed: ${sinks.joinToString { describe(it) }}; ${snapshot()}")
+    }
+  }
+
+  private val heartbeat = object : Runnable {
+    override fun run() {
+      if (player.isPlaying) {
+        log("heartbeat: ${snapshot()}")
+        handler.postDelayed(this, HEARTBEAT_MS)
+      }
+    }
+  }
+
+  fun attach() {
+    player.addAnalyticsListener(this)
+    try { audioManager.registerAudioDeviceCallback(deviceCallback, handler) } catch (_: Exception) {}
+    log("diagnostics on; outputs: ${outputs()}")
+  }
+
+  fun detach() {
+    handler.removeCallbacks(heartbeat)
+    try { player.removeAnalyticsListener(this) } catch (_: Exception) {}
+    try { audioManager.unregisterAudioDeviceCallback(deviceCallback) } catch (_: Exception) {}
+  }
+
+  // the log store is a synchronous database write: keep it off the main thread
+  private fun log(msg: String) { io.execute { AbsLogger.info(tag, msg) } }
+  private fun error(msg: String) { io.execute { AbsLogger.error(tag, msg) } }
+
+  private fun interesting(d: AudioDeviceInfo) =
+    d.type != AudioDeviceInfo.TYPE_BUILTIN_EARPIECE && d.type != AudioDeviceInfo.TYPE_TELEPHONY &&
+      d.type != AudioDeviceInfo.TYPE_BUILTIN_MIC && d.type != AudioDeviceInfo.TYPE_FM_TUNER
+
+  private fun describe(d: AudioDeviceInfo): String {
+    val type = when (d.type) {
+      AudioDeviceInfo.TYPE_BUILTIN_SPEAKER -> "speaker"
+      AudioDeviceInfo.TYPE_WIRED_HEADSET -> "wired headset"
+      AudioDeviceInfo.TYPE_WIRED_HEADPHONES -> "wired headphones"
+      AudioDeviceInfo.TYPE_BLUETOOTH_A2DP -> "bluetooth"
+      AudioDeviceInfo.TYPE_BLUETOOTH_SCO -> "bluetooth (call)"
+      AudioDeviceInfo.TYPE_USB_HEADSET -> "usb headset"
+      AudioDeviceInfo.TYPE_USB_DEVICE -> "usb"
+      AudioDeviceInfo.TYPE_HDMI -> "hdmi"
+      AudioDeviceInfo.TYPE_HEARING_AID -> "hearing aid"
+      26 -> "bluetooth le" // TYPE_BLE_HEADSET, API 31
+      27 -> "bluetooth le speaker"
+      30 -> "bluetooth le broadcast"
+      else -> "type ${d.type}"
+    }
+    val name = d.productName?.toString()?.trim().orEmpty()
+    return if (name.isNotEmpty() && d.type != AudioDeviceInfo.TYPE_BUILTIN_SPEAKER) "$type ($name)" else type
+  }
+
+  private fun outputs(): String = try {
+    audioManager.getDevices(AudioManager.GET_DEVICES_OUTPUTS).filter { interesting(it) }.joinToString { describe(it) }
+  } catch (_: Exception) { "?" }
+
+  private fun stateName(state: Int) = when (state) {
+    Player.STATE_IDLE -> "idle"
+    Player.STATE_BUFFERING -> "buffering"
+    Player.STATE_READY -> "ready"
+    Player.STATE_ENDED -> "ended"
+    else -> "$state"
+  }
+
+  /** One line of everything that decides whether sound comes out. Main thread only. */
+  private fun snapshot(): String = try {
+    val pos = player.currentPosition
+    val ahead = (player.bufferedPosition - pos) / 1000
+    val suppression = when (player.playbackSuppressionReason) {
+      Player.PLAYBACK_SUPPRESSION_REASON_NONE -> "none"
+      Player.PLAYBACK_SUPPRESSION_REASON_TRANSIENT_AUDIO_FOCUS_LOSS -> "AUDIO FOCUS LOSS"
+      else -> "${player.playbackSuppressionReason}"
+    }
+    String.format(Locale.US, "pos %ds buffered +%ds state=%s playWhenReady=%s suppression=%s vol=%.2f devVol=%d/%d speed=%.2f loading=%s musicActive=%s outputs=%s",
+      pos / 1000, ahead, stateName(player.playbackState), player.playWhenReady, suppression, player.volume,
+      audioManager.getStreamVolume(AudioManager.STREAM_MUSIC), audioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC),
+      player.playbackParameters.speed, player.isLoading, audioManager.isMusicActive, outputs())
+  } catch (e: Exception) { "snapshot failed: ${e.message}" }
+
+  override fun onPlayWhenReadyChanged(eventTime: EventTime, playWhenReady: Boolean, reason: Int) {
+    val why = when (reason) {
+      Player.PLAY_WHEN_READY_CHANGE_REASON_USER_REQUEST -> "user"
+      Player.PLAY_WHEN_READY_CHANGE_REASON_AUDIO_FOCUS_LOSS -> "AUDIO FOCUS LOSS"
+      Player.PLAY_WHEN_READY_CHANGE_REASON_AUDIO_BECOMING_NOISY -> "audio becoming noisy (output unplugged or disconnected)"
+      Player.PLAY_WHEN_READY_CHANGE_REASON_REMOTE -> "remote"
+      Player.PLAY_WHEN_READY_CHANGE_REASON_END_OF_MEDIA_ITEM -> "end of item"
+      else -> "$reason"
+    }
+    log("playWhenReady=$playWhenReady ($why)")
+  }
+
+  override fun onPlaybackSuppressionReasonChanged(eventTime: EventTime, playbackSuppressionReason: Int) {
+    if (playbackSuppressionReason == Player.PLAYBACK_SUPPRESSION_REASON_TRANSIENT_AUDIO_FOCUS_LOSS)
+      error("playback SUPPRESSED by a transient audio focus loss: the player keeps its state but no sound until focus returns; ${snapshot()}")
+    else log("playback suppression cleared; ${snapshot()}")
+  }
+
+  override fun onIsPlayingChanged(eventTime: EventTime, isPlaying: Boolean) {
+    log("isPlaying=$isPlaying; ${snapshot()}")
+    handler.removeCallbacks(heartbeat)
+    if (isPlaying) handler.postDelayed(heartbeat, HEARTBEAT_MS)
+  }
+
+  override fun onPlaybackStateChanged(eventTime: EventTime, state: Int) {
+    if (state == lastState) return
+    lastState = state
+    log("state=${stateName(state)}; ${snapshot()}")
+  }
+
+  override fun onPlayerError(eventTime: EventTime, err: PlaybackException) {
+    error("player error ${err.errorCodeName}: ${err.message}; cause=${err.cause?.javaClass?.simpleName} ${err.cause?.message?.take(160)}")
+  }
+
+  override fun onAudioSinkError(eventTime: EventTime, audioSinkError: Exception) {
+    error("audio sink error: ${audioSinkError.javaClass.simpleName} ${audioSinkError.message?.take(160)}; ${snapshot()}")
+  }
+
+  override fun onAudioCodecError(eventTime: EventTime, audioCodecError: Exception) {
+    error("audio codec error: ${audioCodecError.javaClass.simpleName} ${audioCodecError.message?.take(160)}")
+  }
+
+  override fun onAudioUnderrun(eventTime: EventTime, bufferSize: Int, bufferSizeMs: Long, elapsedSinceLastFeedMs: Long) {
+    log("audio underrun: sink buffer $bufferSizeMs ms, $elapsedSinceLastFeedMs ms since last feed; ${snapshot()}")
+  }
+
+  override fun onAudioPositionAdvancing(eventTime: EventTime, playoutStartSystemTimeMs: Long) {
+    log("audio sink advancing (sound is being output); outputs=${outputs()}")
+  }
+
+  override fun onAudioSessionIdChanged(eventTime: EventTime, audioSessionId: Int) {
+    log("audio session id $audioSessionId")
+  }
+
+  override fun onAudioAttributesChanged(eventTime: EventTime, audioAttributes: AudioAttributes) {
+    log("audio attributes usage=${audioAttributes.usage} content=${audioAttributes.contentType}")
+  }
+
+  override fun onVolumeChanged(eventTime: EventTime, volume: Float) {
+    // the sleep-timer fade changes the volume once a second: log the edges, not every step
+    val full = volume >= 0.999f
+    val now = System.currentTimeMillis()
+    if (full != volumeFull || now - volumeLoggedAt > 30_000L) {
+      volumeFull = full
+      volumeLoggedAt = now
+      log(String.format(Locale.US, "player volume %.2f%s", volume, if (full) "" else " (fading or reduced)"))
+    }
+  }
+
+  override fun onDeviceVolumeChanged(eventTime: EventTime, volume: Int, muted: Boolean) {
+    log("device volume $volume muted=$muted")
+  }
+
+  override fun onSkipSilenceEnabledChanged(eventTime: EventTime, skipSilenceEnabled: Boolean) {
+    log("skip silence $skipSilenceEnabled")
+  }
+
+  override fun onAudioDecoderInitialized(eventTime: EventTime, decoderName: String, initializedTimestampMs: Long, initializationDurationMs: Long) {
+    log("audio decoder $decoderName")
+  }
+
+  override fun onAudioInputFormatChanged(eventTime: EventTime, format: Format, decoderReuseEvaluation: DecoderReuseEvaluation?) {
+    log("audio format ${format.sampleMimeType} ${format.sampleRate} Hz ${format.channelCount} ch ${if (format.bitrate > 0) "${format.bitrate / 1000} kbps" else ""}")
+  }
+
+  override fun onLoadError(eventTime: EventTime, loadEventInfo: LoadEventInfo, mediaLoadData: MediaLoadData, err: IOException, wasCanceled: Boolean) {
+    log("load error ${err.javaClass.simpleName}: ${err.message?.take(160)} (${loadEventInfo.uri.host} ${loadEventInfo.uri.path}) canceled=$wasCanceled")
+  }
+
+  override fun onPositionDiscontinuity(eventTime: EventTime, oldPosition: Player.PositionInfo, newPosition: Player.PositionInfo, reason: Int) {
+    if (reason == Player.DISCONTINUITY_REASON_SEEK_ADJUSTMENT || reason == Player.DISCONTINUITY_REASON_INTERNAL) return
+    val why = when (reason) {
+      Player.DISCONTINUITY_REASON_AUTO_TRANSITION -> "next track"
+      Player.DISCONTINUITY_REASON_SEEK -> "seek"
+      Player.DISCONTINUITY_REASON_SEEK_ADJUSTMENT -> "seek adjustment"
+      Player.DISCONTINUITY_REASON_SKIP -> "skip"
+      Player.DISCONTINUITY_REASON_REMOVE -> "remove"
+      Player.DISCONTINUITY_REASON_INTERNAL -> "internal"
+      else -> "$reason"
+    }
+    log("position ${oldPosition.positionMs / 1000}s -> ${newPosition.positionMs / 1000}s ($why)")
+  }
+}
